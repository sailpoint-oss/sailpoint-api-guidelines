{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "deploy": {
    "startCommand": "node .next/standalone/server.js",
    "inputs": [
      "...",
      {
        "step": "build",
        "include": [".next/standalone", ".next/static", "public"],
        "exclude": ["node_modules", ".next/cache"]
      }
    ]
  }
}
